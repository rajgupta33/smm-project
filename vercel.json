{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/index.js" },
    {
      "src": "/assets/(.*\\.(js|css|svg|png|jpg|jpeg|gif|ico))$",
      "dest": "/frontend/assets/$1"
    },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
