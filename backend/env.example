# Database Configuration
MONGO_URI=mongodb://localhost:27017/smm-platform
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/smm-platform

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production

# External SMM API Configuration
API_URL=https://your-smm-provider-api.com
API_KEY=your-smm-provider-api-key
# Additional providers reference their own environment variables from Provider.credentialReference.
# Example database reference: env:SECOND_PROVIDER_API_KEY
SECOND_PROVIDER_API_KEY=your-second-provider-api-key

# Durable job queue (Redis must use maxmemory-policy=noeviction)
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=smm

# Cashfree Payment Gateway (use sandbox credentials until all staging checks pass)
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
CASHFREE_RETURN_URL=http://localhost:5173/payments/return?order_id={order_id}
CASHFREE_NOTIFY_URL=https://your-public-backend.example/api/webhooks/cashfree
CASHFREE_DEFAULT_CUSTOMER_PHONE=9999999999
CASHFREE_MIN_TOPUP_MINOR=10000
CASHFREE_MAX_TOPUP_MINOR=10000000
CASHFREE_WEBHOOK_TOLERANCE_MS=300000
REFILL_DEFAULT_GUARANTEE_DAYS=30
REFILL_COOLDOWN_HOURS=24
REFILL_STATUS_POLL_MINUTES=5
ORDER_STATUS_POLL_MINUTES=10
# How often the worker reads each enabled provider's balance for low-balance alerts
PROVIDER_BALANCE_CHECK_MINUTES=30
# How often the worker re-fetches each enabled provider's service list to detect
# services removed from the provider (a first miss re-checks on the next run;
# a second consecutive miss confirms removal and auto-hides the catalogue service)
SERVICE_AVAILABILITY_CHECK_MINUTES=60

# Maximum allowed selling-price markup in basis points (100000 = 1000%)
MAX_MARKUP_BPS=100000
PROVIDER_TIMEOUT_MS=15000

# Browser and cookie security
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com
TRUST_PROXY=false

# Server Configuration (optional)
PORT=3000
NODE_ENV=development

# --- Reseller program -------------------------------------------------------
# Defaults applied when an admin creates a reseller. Each reseller stores its
# own rate afterwards, so changing these never rewrites an existing reseller.
# 2500 bps = 25% of each order's PROFIT (never of the order total).
RESELLER_DEFAULT_COMMISSION_BPS=2500
# Days a completed order's commission stays held before it is credited to the
# reseller's wallet. Protects against refund and refill clawbacks.
RESELLER_COMMISSION_HOLD_DAYS=7
# How many WhatsApp numbers one reseller may send per day, by default.
RESELLER_DAILY_SHARE_CAP=100
# How often the worker reconciles commissions and pays out matured holds.
RESELLER_PAYOUT_SCAN_MINUTES=60
# How often the worker re-reads the assigned promo Google Sheets.
RESELLER_PROMO_SYNC_MINUTES=30

# --- Reseller WhatsApp marketing (Google Apps Script) -----------------------
# Deploy backend/../tools/promo-sheet/Code.gs as a Web app (Execute as: Me,
# Who has access: Anyone) and paste the /exec URL here. These credentials stay
# server-side: resellers call the panel API and never see the sheet or the key.
# Leave unset to keep the marketing section turned off.
PROMO_SHEET_SCRIPT_URL=
PROMO_SHEET_SECRET_KEY=
PROMO_SHEET_TIMEOUT_MS=20000
